# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# IDE specific folders and data
.idea
cmake-build-debug

# Generated build and package output. Keep tracked placeholders in each
# directory so fresh clones have the expected layout.
/bin/*
!/bin/.gitignore
/build/*
!/build/.gitignore
/lib/*
!/lib/.gitignore
/packages/*
!/packages/.gitignore

# Obsolete/generated STM32 IDE artifacts are not part of the DAS harness.
/test/package_tester/.metadata/
/test/package_tester/stm32h7xx/Middlewares/
/test/package_tester/stm32h7xx/STM32CubeIDE/
